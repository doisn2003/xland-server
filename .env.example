NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=0
# Railway public edge: set TRUST_PROXY_HOPS=1. Do not expose the container directly.
# Set only in the server environment; existing .env must be preserved.
# Provision private values with: node --import tsx scripts/provision-local.mjs
# Run using --env-file=.env.local; do not paste credentials here.
# DATABASE_URL=
DATABASE_ENVIRONMENT=development
# DATABASE_APPROVED_FINGERPRINT=
# CURSOR_SECRET= (persistent random secret, at least32bytes; required for cursor/idempotency encryption)
CORS_ORIGINS=http://localhost:5555,http://127.0.0.1:5555
# PUBLIC_BASE_URL=https://your-controlled-host.example/
# AVATAR_ORIGINS=https://your-controlled-media-host.example
# TEST_DATABASE_URL= (separate xland_test_* DB; managed automatically by test scripts)
# TEST_DATABASE_ENVIRONMENT=test
# Payment live is disabled in source; no live provider credentials are accepted.
# Auth operator overlay: copy config/auth.env.example to private .env.auth.
# Load it after the existing server environment; default-off until configured.
XLAND_GOOGLE_LOGIN_ENABLED=false
GOOGLE_AUTH_AUDIENCES=
XLAND_PHONE_OTP_ENABLED=false
XLAND_SMS_PROVIDER=
SMS_BRANDNAME_APPROVED=false
# Maps: Geoapify Free only. Private local overlay is .env.geoapify.
MAPS_GEOAPIFY_ENABLED=false
MAPS_GEOAPIFY_API_KEY=
MAPS_GEOAPIFY_DAILY_CREDITS=2400

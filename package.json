{
  "name": "xland-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "check:foundation": "node scripts/verify-foundation.mjs",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:auth": "node --import tsx tests/auth/run-local.mjs",
    "test:admin": "node --import tsx tests/admin/run-local.mjs",
    "admin:setup": "node --import tsx scripts/admin-setup.mjs",
    "admin:dev": "node --import tsx scripts/admin-dev.mjs",
    "test:authors": "node --import tsx tests/authors/run-local.mjs",
    "verify:authors": "node scripts/release/verify-authors.mjs",
    "test:sharing": "node --import tsx tests/sharing/run-local.mjs",
    "auth:cleanup": "node --import tsx src/auth/cleanup-cli.ts",
    "test:integration": "node scripts/test-postgres.mjs integration",
    "test:contract": "node scripts/test-postgres.mjs contract",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "google-auth-library": "11.3.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}

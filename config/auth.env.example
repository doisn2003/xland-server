# Public template. Private destination: xland-server/.env.auth (git ignored).
# Do not put DATABASE_URL here; keep the existing server DB configuration.
# Google backend audience = OAuth Web client ID, not Android client ID.
XLAND_GOOGLE_LOGIN_ENABLED=false
GOOGLE_AUTH_AUDIENCES=
# SMS stays disabled until provider, Xgroup and exact OTP template are approved.
XLAND_PHONE_OTP_ENABLED=false
XLAND_SMS_PROVIDER=
SMS_BRANDNAME_APPROVED=false
SMS_BRANDNAME=Xgroup
SMS_OTP_TEMPLATE=
ESMS_API_KEY=
ESMS_SECRET_KEY=
# Generate a stable high-entropy server-only value >=32 bytes. Never send in chat.
OTP_HMAC_KEY=
# Separate opt-in for maintenance --apply; not required for normal auth/runtime.
AUTH_RETENTION_APPROVED_FINGERPRINT=
